# respira-data environment template
# Full reference: docs/respira-data-env-vars.md
#
# Quick start:
# 1) Copy this file to .env
# 2) Fill REQUIRED values first (database + model paths if scheduling inference)
# 3) Leave optional values commented out unless you need to override defaults

# -----------------------------------------------------------------------------
# Required: Remote PostgreSQL for dbt and runtime tasks
# -----------------------------------------------------------------------------
REMOTE_PG_HOST=your_remote_host
REMOTE_PG_PORT=5432
REMOTE_PG_DB=airbyte_db
REMOTE_PG_USER=airbyte_user
REMOTE_PG_PASSWORD=airbyte_pass

# Optional DB settings
REMOTE_PG_SSLMODE=require
REMOTE_PG_SCHEMA=airbyte
# Legacy aliases (prefer REMOTE_PG_DB and DB_DSN)
# REMOTE_PG_NAME=airbyte_db
# DBT_POSTGRES_URI=postgresql://user:pass@host:5432/dbname

# Optional DSN for Python tasks (dbt still reads REMOTE_PG_* from dbt/profiles.yml)
# DB_DSN=postgresql+psycopg://user:pass@host:5432/dbname?sslmode=require

# -----------------------------------------------------------------------------
# Prefect API, worker, and local server
# -----------------------------------------------------------------------------
PREFECT_API_URL=http://prefect_server:4200/api

# Worker behavior
# PREFECT_WORKER_TYPE=process
# PREFECT_SCHEDULE_TIMEZONE=UTC
# PREFECT_CANONICAL_WORK_POOL=canonical
# PREFECT_PROJECT_RESPIRA_GOLD_WORK_POOL=respira_gold
# PREFECT_SOCIAL_BROADCAST_WORK_POOL=respira_gold
# Legacy shared pool fallback:
# PREFECT_WORK_POOL=canonical

# Worker startup wait tuning (advanced)
# PREFECT_API_WAIT_MAX_ATTEMPTS=90
# PREFECT_API_WAIT_SLEEP_SECONDS=2
# PREFECT_WAIT_TIMEOUT_S=120
# PREFECT_WAIT_INTERVAL_S=2

# Local Prefect server (docker-compose override values)
# HOST_WORKSPACE_FOLDER=/absolute/path/to/respira-data
# PREFECT_UI_URL=http://localhost:4200
# PREFECT_UI_API_URL=http://localhost:4200/api
# PREFECT_UI_SERVE_BASE=/
# PREFECT_SERVER_API_HOST=0.0.0.0
# PREFECT_SERVER_API_PORT=4200

# Deployment schedules (cron, interpreted in PREFECT_SCHEDULE_TIMEZONE)
# PREFECT_CANONICAL_INCREMENTAL_CRON=5 * * * *
# PREFECT_PROJECT_RESPIRA_GOLD_CRON=20 * * * *
# PREFECT_SOCIAL_BROADCAST_CRON=0 11,20 * * *

# -----------------------------------------------------------------------------
# dbt runtime controls (optional)
# -----------------------------------------------------------------------------
# DBT_PROJECT_DIR=/app/dbt
# DBT_PROFILES_DIR=/app/dbt
# DBT_TARGET=prod
# DBT_THREADS=1
# DBT_USE_PREFECT_DBT=false
# DBT_TIMEOUT_CANONICAL_CORE_S=0
# DBT_TIMEOUT_CANONICAL_BATCH_INGEST_S=3600
# DBT_TIMEOUT_CANONICAL_SILVER_S=1800
# DBT_TIMEOUT_PROJECT_S=1200
# DBT_TIMEOUT_TESTS_S=1200

# -----------------------------------------------------------------------------
# Inference and backfill
# -----------------------------------------------------------------------------
# Required to enable scheduled inference deployments:
# MODEL_6H_PATH=/app/models/model_6h.pkl
# MODEL_12H_PATH=/app/models/model_12h.pkl

# Optional inference/backfill tuning
# MODEL_6H_VERSION=unknown
# MODEL_12H_VERSION=unknown
# DEFAULT_WINDOW_HOURS=24
# INFERENCE_MIN_POINTS=18
# MEASUREMENT_BACKFILL_PROCESS_BATCH_HOURS=720
# MEASUREMENT_TIMESTAMP_QUEUE_RETENTION_HOURS=168
# MEASUREMENT_INCREMENTAL_MAX_EXPANDED_ROWS=2000000
# MEASUREMENT_QUEUE_CUTOVER_BATCH_HOURS=168
# MEASUREMENT_QUEUE_CUTOVER_MAX_QUEUE_ROWS=250000

# -----------------------------------------------------------------------------
# Alerts and social publishing
# -----------------------------------------------------------------------------
# Optional Slack alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Social broadcast core
SOCIAL_DRY_RUN=true
SOCIAL_DATA_MAX_AGE_HOURS=6
SOCIAL_MIN_STATIONS_PER_REGION=1

# Telegram (only required if TELEGRAM_ENABLED=true)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# X / Twitter (only required if TWITTER_ENABLED=true)
TWITTER_ENABLED=false
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
