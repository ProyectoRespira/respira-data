# Stage 1: Builder
# Uses full python:3.12 image so build tools are available if a dependency
# ever needs to compile a wheel; none of them reach the runtime image.
FROM python:3.12 AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Poetry lives in its own venv so it is not copied into the runtime image
# together with /usr/local.
RUN python -m venv /opt/poetry \
    && /opt/poetry/bin/pip install "poetry==2.2.1" "poetry-plugin-export==1.9.0"

COPY pyproject.toml poetry.lock /build/

# Runtime dependencies plus the inference group; dev tools are excluded.
# --no-compile skips precompiled .pyc files (Python compiles on import).
RUN /opt/poetry/bin/poetry export --only main,inference --format requirements.txt --output requirements.txt \
    && pip install --no-compile -r requirements.txt


# Stage 2: Runtime
# Uses python:3.12-slim (smaller base) - build tools are not included
FROM python:3.12-slim

WORKDIR /app

# Install only runtime dependencies (no build tools needed)
RUN apt-get update && apt-get install -y --no-install-recommends \
    procps \
    libgomp1 \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy the installed dependencies and their console scripts from builder stage
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Replaces the editable root install: like Poetry's .pth, appends /app/src and
# /app to sys.path so `pipelines` and `inference` are importable without
# shadowing installed packages.
RUN printf '/app/src\n/app\n' > /usr/local/lib/python3.12/site-packages/respira_data.pth

# Copy application code
COPY . /app

# Copy startup script outside /app so volume mounts cannot shadow it
COPY scripts/prefect_worker_start.sh /usr/local/bin/prefect_worker_start.sh
RUN chmod +x /usr/local/bin/prefect_worker_start.sh

# Health check to verify Prefect worker is available
HEALTHCHECK --interval=15s --timeout=10s --start-period=20s --retries=3 \
    CMD pgrep -f "prefect worker start" > /dev/null || exit 1
